# paypal sandbox app credentials (developer.paypal.com > apps & credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# stdio (local @paypal/mcp) or sse (hosted)
PAYPAL_MCP_TRANSPORT=stdio
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# local compose stack
POSTGRES_PASSWORD=warden
SERVICE_DB_PASSWORD=warden

# shared secret other services use to call paypal-connector (openssl rand -hex 32)
CONNECTOR_TOKEN=
CONNECTOR_PORT=7001
# a sandbox account other than the merchant (payouts to yourself fail with SELF_PAY_NOT_ALLOWED)
DEMO_CONTRACTOR_EMAIL=
