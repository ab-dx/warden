# paypal sandbox app credentials (developer.paypal.com > apps & credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# stdio (local @paypal/mcp) or sse (hosted)
PAYPAL_MCP_TRANSPORT=stdio
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse

# local compose stack
POSTGRES_PASSWORD=warden
SERVICE_DB_PASSWORD=warden

# shared secret other services use to call paypal-connector (openssl rand -hex 32)
CONNECTOR_TOKEN=
CONNECTOR_PORT=7001
# a sandbox account other than the merchant (payouts to yourself fail with SELF_PAY_NOT_ALLOWED)
DEMO_CONTRACTOR_EMAIL=

# guard-worker; POLICY_TOKEN is the shared secret for policy-service (openssl rand -hex 32)
POLICY_TOKEN=
GUARD_DATABASE_URL=postgres://guard:warden@localhost:5432/guard
KAFKA_BROKERS=localhost:29092
TEMPORAL_ADDRESS=localhost:7233

# policy-service
POLICY_DATABASE_URL=postgres://policy:warden@localhost:5432/policy
POLICY_FILE=../../docs/policy.example.yaml
POLICY_PORT=7003

# edge-gateway: what agents connect to. keys are agent-id:key pairs, 24+ characters each
WARDEN_AGENT_KEYS=
GATEWAY_PORT=7000
GATEWAY_DATABASE_URL=postgres://gateway:warden@localhost:5432/gateway
GATEWAY_HOLD_MS=45000
APPROVAL_TIMEOUT_MS=120000
DASHBOARD_URL=http://localhost:5173
# the agent's other mcp servers, proxied so warden knows what it read
UNTRUSTED_MCP_URLS=http://localhost:7010/mcp

# judge-service: provenance checks. leave JUDGE_URL empty on the guard-worker to decide by policy alone
JUDGE_TOKEN=
JUDGE_URL=http://localhost:7006
JUDGE_DATABASE_URL=postgres://judge:warden@localhost:5432/judge
# llm intent judge, any openai-compatible endpoint. empty keeps only the provenance check.
# the local ollama profile is http://ollama:11434/v1 from inside compose
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_TIMEOUT_MS=10000
JUDGE_MIN_CONFIDENCE=0.7

# ledger-service
LEDGER_TOKEN=
LEDGER_DATABASE_URL=postgres://ledger:warden@localhost:5432/ledger
LEDGER_PORT=7004

# api + dashboard: the only place a person can approve a payment
API_PORT=7005
DASHBOARD_USER=owner
# at least 12 characters
DASHBOARD_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# set to true when served over https
COOKIE_SECURE=false
# signs mandates as tokens anyone can verify against /.well-known/jwks.json (pnpm setup:env fills it)
MANDATE_SIGNING_KEY=
# the public hostname, only for deploy/compose/public.yaml (https via caddy)
WARDEN_DOMAIN=
# optional: held payments also go to this telegram chat with approve and reject buttons.
# make a bot with @BotFather, message it once, then read your chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# demo agent. scripted needs nothing; llm works with any openai-compatible endpoint
# (openrouter, gemini's openai api, or the local ollama profile: http://localhost:11434/v1)
WARDEN_AGENT_KEY=
# the benchmark's own agent (pnpm setup:env adds it to WARDEN_AGENT_KEYS)
BENCH_AGENT_KEY=
AGENT_DRIVER=scripted
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
