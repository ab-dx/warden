{
  "name": "@warden/ops-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "scenarios"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inbox": "node --env-file-if-exists=../../.env dist/inbox-server.js",
    "agent": "node --env-file-if-exists=../../.env dist/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
