{
  "name": "@warden/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "buf generate ../../proto --template ../../proto/buf.gen.yaml",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0"
  }
}
