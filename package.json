{
  "name": "warden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "paypal:tools": "node --env-file=.env scripts/dump-paypal-tools.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/mcp": "1.8.1",
    "@types/node": "^24.19.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  }
}
